# TMDB — server-only, never expose to client
TMDB_API_KEY=

# Firebase — public client config (safe to expose)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Sentry — error tracking (client + server). Optional: without PUBLIC_SENTRY_DSN
# the SDK is a no-op. SENTRY_ORG/PROJECT/AUTH_TOKEN are only needed to upload
# sourcemaps for readable stack traces (build-time only, never sent to the client).
PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
