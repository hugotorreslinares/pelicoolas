# TMDB — server-only, never expose to client
TMDB_API_KEY=

# OMDb — server-only, never expose to client. Rotten Tomatoes/Metacritic
# ratings for the movie details dialog; optional, degrades silently if unset.
OMDB_API_KEY=

# Firebase — public client config (safe to expose)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — server-only, privileged. Needed only by the release-check
# cron (src/pages/api/cron/check-releases.ts), which reads across every
# user's followedPeople — something the client SDK can't do under
# firestore.rules. Generate: Firebase Console > Project settings > Service
# accounts > Generate new private key. Paste the whole downloaded JSON as a
# single-line string here.
FIREBASE_SERVICE_ACCOUNT=

# Shared secret the release-check cron checks on every request (Vercel Cron
# sends it as `Authorization: Bearer $CRON_SECRET` automatically once this
# env var is set in the Vercel project) — without it, the endpoint is
# unauthenticated and would let anyone trigger TMDB calls + Firestore writes
# across all users. Generate any long random string.
CRON_SECRET=

# Sentry — error tracking (client + server). Optional: without PUBLIC_SENTRY_DSN
# the SDK is a no-op. SENTRY_ORG/PROJECT/AUTH_TOKEN are only needed to upload
# sourcemaps for readable stack traces (build-time only, never sent to the client).
PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
