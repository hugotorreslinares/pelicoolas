---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import { RecommendationsBoard } from "@/components/board/RecommendationsBoard";

const { userId } = Astro.params;
if (!userId) return Astro.redirect("/");

import { getDictionary } from "@/i18n";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
---

<Layout
  title={`${t.board.movieRecommendations} — Pelicoolas`}
  description={t.board.visitorSubtitle}
>
  <RecommendationsBoard userId={userId} locale={locale} client:load />
</Layout>
