---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import { getDictionary } from "@/i18n";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
const p = t.privacy;
---

<Layout title={p.title} description={p.metaDescription}>
  <div class="mx-auto max-w-2xl space-y-6">
    <h1 class="text-2xl font-bold">{p.heading}</h1>
    <p class="text-sm text-muted-foreground">{p.lastUpdated}</p>

    <section class="space-y-2">
      <h2 class="text-lg font-semibold">{p.noSellHeading}</h2>
      <p>{p.noSellBody}</p>
    </section>

    <section class="space-y-2">
      <h2 class="text-lg font-semibold">{p.whatWeCollectHeading}</h2>
      <ul class="list-inside list-disc space-y-1">
        <li>
          <strong>{p.accountInfoLabel}</strong>: {p.accountInfoBody}
        </li>
        <li>
          <strong>{p.activityLabel}</strong>: {p.activityBody}
        </li>
        <li>
          <strong>{p.publicProfileLabel}</strong>: {p.publicProfileBefore}<code
            >/u/&#123;you&#125;</code
          >{p.publicProfileAfter}
        </li>
        <li>
          <strong>{p.analyticsLabel}</strong>: {p.analyticsBody}
        </li>
      </ul>
    </section>

    <section class="space-y-2">
      <h2 class="text-lg font-semibold">{p.whoElseHeading}</h2>
      <ul class="list-inside list-disc space-y-1">
        <li>
          <strong>{p.firebaseLabel}</strong> — {p.firebaseBody}
        </li>
        <li>
          <strong>{p.vercelLabel}</strong> — {p.vercelBody}
        </li>
        <li>
          <strong>{p.tmdbLabel}</strong> — {p.tmdbBody}
        </li>
      </ul>
      <p>{p.noAdvertisingBody}</p>
    </section>

    <section class="space-y-2">
      <h2 class="text-lg font-semibold">{p.cookiesHeading}</h2>
      <p>{p.cookiesBody}</p>
    </section>

    <section class="space-y-2">
      <h2 class="text-lg font-semibold">{p.yourRightsHeading}</h2>
      <ul class="list-inside list-disc space-y-1">
        <li>
          <strong>{p.accessExportLabel}</strong> — {
            p.accessExportBody(t.account.exportData)
          }
        </li>
        <li>
          <strong>{p.deletionLabel}</strong> — {p.deletionBody}
        </li>
        <li>
          <strong>{p.correctionLabel}</strong> — {p.correctionBody}
        </li>
      </ul>
      <p>{p.gdprCcpaBody}</p>
    </section>

    <section class="space-y-2">
      <h2 class="text-lg font-semibold">{p.childrenHeading}</h2>
      <p>{p.childrenBody}</p>
    </section>

    <section class="space-y-2">
      <h2 class="text-lg font-semibold">{p.contactHeading}</h2>
      <p>{p.contactBody}</p>
    </section>
  </div>
</Layout>
