---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import { MovieMap } from "@/components/connections/MovieMap";
import { getDictionary } from "@/i18n";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
---

<Layout
  title="Movie Map — Pelicoolas"
  description={t.movieMap.metaDescription}
  noindex
>
  <h1 class="mb-4 text-xl font-semibold">{t.nav.movieMap}</h1>
  <MovieMap locale={locale} client:load />
</Layout>
