---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { Dashboard } from "@/components/filmography/Dashboard";
import { RecentUsersSlider } from "@/components/social/RecentUsersSlider";
import { getTrendingMovies } from "@/lib/tmdb/movies";
import { getTrendingTV } from "@/lib/tmdb/tv";
import { TmdbError } from "@/lib/tmdb/client";

const locale = Astro.locals.locale;

// Best-effort: if TMDB is down, the dashboard still renders fine without
// the trending rows rather than breaking the whole page over it. Fetched
// in parallel — one TmdbError shouldn't wait on the other's round-trip.
let trendingMovies: Awaited<ReturnType<typeof getTrendingMovies>> = [];
let trendingTV: Awaited<ReturnType<typeof getTrendingTV>> = [];
const [moviesResult, tvResult] = await Promise.allSettled([
  getTrendingMovies(),
  getTrendingTV(),
]);
if (moviesResult.status === "fulfilled") {
  trendingMovies = moviesResult.value;
} else if (!(moviesResult.reason instanceof TmdbError)) {
  throw moviesResult.reason;
}
if (tvResult.status === "fulfilled") {
  trendingTV = tvResult.value;
} else if (!(tvResult.reason instanceof TmdbError)) {
  throw tvResult.reason;
}
---

<Layout
  title="Pelicoolas — Filmography Tracker"
  description="Follow your favorite actors and directors and track which of their movies you've already watched."
  showDeployInfo
  noindex
>
  <div class="space-y-8">
    <Dashboard
      client:load
      locale={locale}
      trendingMovies={trendingMovies}
      trendingTV={trendingTV}
      limit={15}
    />
    <RecentUsersSlider locale={locale} client:idle />
  </div>
</Layout>
