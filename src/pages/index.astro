---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { Dashboard } from "@/components/filmography/Dashboard";
import { getTrendingMovies } from "@/lib/tmdb/movies";
import { TmdbError } from "@/lib/tmdb/client";

// Best-effort: if TMDB is down, the dashboard still renders fine without
// the trending row rather than breaking the whole page over it.
let trendingMovies: Awaited<ReturnType<typeof getTrendingMovies>> = [];
try {
  trendingMovies = await getTrendingMovies();
} catch (e) {
  if (!(e instanceof TmdbError)) throw e;
}
---

<Layout
  title="Filmo — Filmography Tracker"
  description="Follow your favorite actors and directors and track which of their movies you've already watched."
  showDeployInfo
  noindex
>
  <Dashboard client:load trendingMovies={trendingMovies} />
</Layout>
