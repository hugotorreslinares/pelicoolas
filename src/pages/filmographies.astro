---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { Dashboard } from "@/components/filmography/Dashboard";

import { getDictionary } from "@/i18n";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
---

<Layout
  title={`${t.dashboard.heading} — Pelicoolas`}
  description={t.dashboard.findPerson}
  noindex
  canonicalPath="/"
>
  <Dashboard client:load locale={locale} />
</Layout>
