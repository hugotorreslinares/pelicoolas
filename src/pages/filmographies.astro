---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { Dashboard } from "@/components/filmography/Dashboard";

const locale = Astro.locals.locale;
---

<Layout
  title="My Filmographies — Pelicoolas"
  description="Follow your favorite actors and directors and track which of their movies you've already watched."
  noindex
  canonicalPath="/"
>
  <Dashboard client:load locale={locale} />
</Layout>
