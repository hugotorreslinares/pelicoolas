---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { PersonHeader } from "@/components/people/PersonHeader";
import { PersonSearch } from "@/components/people/PersonSearch";
import PersonInfo from "@/components/people/PersonInfo.astro";
import { Filmography } from "@/components/filmography/Filmography";
import { getPersonProfile } from "@/lib/tmdb/people";
import { getFilmography } from "@/lib/tmdb/movies";
import { TmdbError } from "@/lib/tmdb/client";
import { tmdbImageUrl } from "@/lib/tmdb/image";
import type { CreditDepartment } from "@/types/filmography";

const MAX_DESCRIPTION_LENGTH = 160;

function truncate(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  return `${text.slice(0, maxLength - 1).trimEnd()}…`;
}

const personId = Number(Astro.params.id);
let error: string | null = null;
let profile = null;
let department: CreditDepartment = "Acting";
let movies: Awaited<ReturnType<typeof getFilmography>> = [];

if (!Number.isInteger(personId)) {
  error = "No people found. Try another name.";
} else {
  try {
    profile = await getPersonProfile(personId);
    department =
      profile.knownForDepartment === "Directing" ? "Directing" : "Acting";
    movies = await getFilmography(personId, department);
  } catch (e) {
    error =
      e instanceof TmdbError
        ? "We couldn't load this filmography. Please try again."
        : "No people found. Try another name.";
  }
}
const description = profile
  ? profile.biography
    ? truncate(profile.biography, MAX_DESCRIPTION_LENGTH)
    : `See ${profile.name}'s full filmography and track which movies you've watched.`
  : undefined;
const ogImage = profile?.profilePath
  ? tmdbImageUrl(profile.profilePath, 500)
  : undefined;
---

<Layout
  title={profile ? `${profile.name} — Filmo` : "Filmo"}
  description={description}
  image={ogImage}
  noindex={!profile}
>
  <PersonSearch className="max-w-sm space-y-4" showRecent={false} client:load />

  {error && <p class="mt-4 text-destructive">{error}</p>}

  {
    profile && (
      <div class="mt-4 flex flex-col gap-8 sm:flex-row">
        <div class="space-y-8 sm:w-64 sm:shrink-0">
          <PersonHeader
            profile={profile}
            department={department}
            movieCount={movies.length}
            client:load
          />
          <PersonInfo profile={profile} movieCount={movies.length} />
        </div>
        <div class="flex-1">
          <Filmography
            personId={profile.id}
            personName={profile.name}
            movies={movies}
            client:load
          />
        </div>
      </div>
    )
  }
</Layout>
