---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { PersonHeader } from "@/components/people/PersonHeader";
import { Filmography } from "@/components/filmography/Filmography";
import { getPersonProfile } from "@/lib/tmdb/people";
import { getFilmography } from "@/lib/tmdb/movies";
import { TmdbError } from "@/lib/tmdb/client";
import { tmdbImageUrl } from "@/lib/tmdb/image";
import { ArrowLeftIcon, ClapperboardIcon } from "lucide-react";
import engagement from "@/config/engagement.json";
import { getDictionary } from "@/i18n";
import type { CreditDepartment } from "@/types/filmography";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
const MAX_DESCRIPTION_LENGTH = 160;

function truncate(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  return `${text.slice(0, maxLength - 1).trimEnd()}…`;
}

const personId = Number(Astro.params.id);
let error: string | null = null;
let profile = null;
let department: CreditDepartment = "Acting";
let movies: Awaited<ReturnType<typeof getFilmography>> = [];

if (!Number.isInteger(personId)) {
  error = t.search.noPeopleFound;
} else {
  try {
    profile = await getPersonProfile(personId);
    department =
      profile.knownForDepartment === "Directing" ? "Directing" : "Acting";
    movies = await getFilmography(personId, department);
  } catch (e) {
    error =
      e instanceof TmdbError
        ? t.search.couldntLoadPerson
        : t.search.noPeopleFound;
  }
}
const description = profile
  ? profile.biography
    ? truncate(profile.biography, MAX_DESCRIPTION_LENGTH)
    : t.personHeader.defaultBio(profile.name)
  : undefined;
const ogImage = profile?.profilePath
  ? tmdbImageUrl(profile.profilePath, 500)
  : undefined;

// "On this day": any movie in this filmography whose release month/day
// matches today, any year — a small, cheap way to surface a fun fact from
// data already fetched for the page, no extra requests.
let onThisDayMovie: (typeof movies)[number] | null = null;
if (engagement.onThisDay) {
  const today = new Date();
  onThisDayMovie =
    movies.find((m) => {
      if (!m.releaseDate) return false;
      const [, month, day] = m.releaseDate.split("-").map(Number);
      return month === today.getMonth() + 1 && day === today.getDate();
    }) ?? null;
}

// No client-side navigation history to rely on (every link here is a
// plain full-page <a>), so "back to where you came from" comes from the
// Referer header — only trusted for same-origin, known routes, so a
// direct link or search-engine visit just shows no breadcrumb at all
// instead of a misleading one.
let backHref: string | null = null;
let backLabel: string | null = null;
const referer = Astro.request.headers.get("referer");
if (referer) {
  try {
    const refUrl = new URL(referer);
    if (refUrl.origin === Astro.url.origin) {
      if (refUrl.pathname === "/watchlist") {
        backHref = "/watchlist";
        backLabel = t.personHeader.backToWatchlist;
      } else if (
        refUrl.pathname === "/" ||
        refUrl.pathname === "/filmographies"
      ) {
        backHref = "/filmographies";
        backLabel = t.personHeader.backToFilmographies;
      } else if (refUrl.pathname === "/search") {
        backHref = "/search";
        backLabel = t.personHeader.backToSearch;
      } else if (
        refUrl.pathname.startsWith("/person/") &&
        refUrl.pathname !== Astro.url.pathname
      ) {
        backHref = refUrl.pathname;
        backLabel = t.personHeader.backToFilmography;
      }
    }
  } catch {
    // Malformed Referer header — just skip the breadcrumb.
  }
}
---

<Layout
  title={profile ? `${profile.name} — Pelicoolas` : "Pelicoolas"}
  description={description}
  image={ogImage}
  noindex={!profile}
>
  {
    backHref && (
      <a
        href={backHref}
        class="focus-ring mb-2 inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground"
      >
        <ArrowLeftIcon className="size-3.5" />
        {backLabel}
      </a>
    )
  }

  {error && <p class="text-destructive">{error}</p>}

  {
    onThisDayMovie && (
      <p class="mt-4 flex items-center gap-1.5 text-sm text-muted-foreground">
        <ClapperboardIcon className="size-4 shrink-0" />
        {t.personHeader.onThisDay(
          onThisDayMovie.releaseYear ?? 0,
          onThisDayMovie.title,
        )}
      </p>
    )
  }

  {
    profile && (
      <div class="mt-4 space-y-8">
        <PersonHeader
          profile={profile}
          department={department}
          movieCount={movies.length}
          locale={locale}
          client:load
        />
        <Filmography
          locale={locale}
          personId={profile.id}
          personName={profile.name}
          movies={movies}
          client:load
        />
      </div>
    )
  }
</Layout>
