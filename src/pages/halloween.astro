---
export const prerender = false;

import { setCdnCache } from "@/lib/cdnCache";
import Layout from "@/layouts/Layout.astro";
import { HalloweenChallenge } from "@/components/challenge/HalloweenChallenge";

import { getDictionary } from "@/i18n";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
setCdnCache(Astro.response.headers, 3600);
---

<Layout
  title={`${t.halloween.heading} — Pelicoolas`}
  description={t.halloween.metaDescription}
  noindex
>
  <HalloweenChallenge locale={locale} client:load />
</Layout>
