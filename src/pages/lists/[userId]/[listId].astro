---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { ListDetailPage } from "@/components/lists/ListDetailPage";

import { getDictionary } from "@/i18n";

const { userId, listId } = Astro.params;
if (!userId || !listId) return Astro.redirect("/");

const locale = Astro.locals.locale;
const t = getDictionary(locale);
---

<Layout
  title={`${t.lists.heading} — Pelicoolas`}
  description={t.lists.metaDescription}
  noindex
>
  <ListDetailPage userId={userId} listId={listId} locale={locale} client:load />
</Layout>
