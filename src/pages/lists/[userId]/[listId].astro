---
export const prerender = false;

import { setCdnCache } from "@/lib/cdnCache";
import Layout from "@/layouts/Layout.astro";
import { ListDetailPage } from "@/components/lists/ListDetailPage";
import { getListSummary } from "@/lib/listSummary";

import { getDictionary } from "@/i18n";

const { userId, listId } = Astro.params;
if (!userId || !listId) return Astro.redirect("/");

const locale = Astro.locals.locale;
const t = getDictionary(locale);
const es = locale === "es";

const { name, movieCount, titles } = await getListSummary(userId, listId);
if (name) setCdnCache(Astro.response.headers, 300);
const title = name ? `${name} — Pelicoolas` : `${t.lists.heading} — Pelicoolas`;
const description = name
  ? es
    ? `${movieCount} ${movieCount === 1 ? "película" : "películas"} en esta lista de Pelicoolas.`
    : `${movieCount} ${movieCount === 1 ? "movie" : "movies"} in this Pelicoolas list.`
  : t.lists.metaDescription;

// schema.org/ItemList — same rich-results intent as the Movie/TVSeries JSON-LD
// on /movie and /tv. `<` escape blocks a title shaped like `</script>`
// from ever closing this tag early.
const jsonLd = name
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name,
      numberOfItems: movieCount,
      itemListElement: titles.map((movieTitle, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: movieTitle,
      })),
    }).replace(/</g, "\\u003c")
  : null;
---

<Layout
  title={title}
  description={description}
  image={`/api/og/list/${userId}/${listId}.png`}
  imageAlt={title}
>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}
  <ListDetailPage userId={userId} listId={listId} locale={locale} client:load />
</Layout>
