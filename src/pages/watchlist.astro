---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { WatchlistPage } from "@/components/filmography/WatchlistPage";

import { getDictionary } from "@/i18n";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
---

<Layout
  title={`${t.watchlist.heading} — Pelicoolas`}
  description={t.watchlist.metaDescription}
  noindex
>
  <WatchlistPage client:load locale={locale} />
</Layout>
