---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { MovieDetailActions } from "@/components/movies/MovieDetailActions";
import { MovieMap } from "@/components/connections/MovieMap";
import { getMovieDetails } from "@/lib/tmdb/movies";
import { resolveWatchRegion } from "@/lib/region";
import {
  tmdbImageUrl,
  tmdbWidthSrcSet,
  tmdbDensitySrcSet,
} from "@/lib/tmdb/image";
import { getDictionary } from "@/i18n";
import type { MovieDetails } from "@/types/movie";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
const MAX_DESCRIPTION_LENGTH = 160;

function truncate(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  return `${text.slice(0, maxLength - 1).trimEnd()}…`;
}

const movieId = Number(Astro.params.id);
let movie: MovieDetails | null = null;
let error: string | null = null;

if (!Number.isInteger(movieId)) {
  error = t.movie.couldntLoadMovie;
} else {
  try {
    const region = resolveWatchRegion(
      Astro.request.headers.get("accept-language"),
    );
    movie = await getMovieDetails(movieId, region);
  } catch {
    error = t.movie.couldntLoadMovie;
  }
}

// Public, anonymous-identical content: let Vercel's CDN serve it instead of
// running the function per visit. Vary keeps the per-locale/per-session-hint
// markup from leaking across visitors.
if (movie) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=86400, stale-while-revalidate=604800",
  );
  Astro.response.headers.set("Vary", "Accept-Language");
}

const description = movie
  ? movie.overview
    ? truncate(movie.overview, MAX_DESCRIPTION_LENGTH)
    : t.movie.noOverview
  : undefined;
const ogImage = movie?.posterPath
  ? tmdbImageUrl(movie.posterPath, 500)
  : undefined;

// Schema.org structured data — lets Google show rich results (rating,
// cast) directly in search for movie-name queries. `<` escape blocks
// a `</script>`-shaped title/overview from ever closing this tag early.
const jsonLd = movie
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Movie",
      name: movie.title,
      ...(ogImage && { image: ogImage }),
      ...(movie.overview && { description: movie.overview }),
      ...(movie.genres.length > 0 && { genre: movie.genres }),
      ...(movie.voteAverage && {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: movie.voteAverage,
          bestRating: 10,
          worstRating: 0,
        },
      }),
      ...(movie.cast.length > 0 && {
        actor: movie.cast.map((c) => ({ "@type": "Person", name: c.name })),
      }),
    }).replace(/</g, "\\u003c")
  : null;

const tmdbMovie = movie
  ? {
      tmdbMovieId: movie.id,
      title: movie.title,
      posterPath: movie.posterPath,
      releaseYear: movie.releaseYear,
      voteAverage: movie.voteAverage,
      genreIds: movie.genreIds,
      mediaType: "movie" as const,
    }
  : null;

const subtitle = movie
  ? [
      movie.releaseYear ?? t.movie.unknown,
      movie.runtimeMinutes ? t.movie.minutes(movie.runtimeMinutes) : null,
      movie.genres.join(", ") || null,
    ]
      .filter(Boolean)
      .join(" · ")
  : "";
---

<Layout
  title={movie ? `${movie.title} — Pelicoolas` : "Pelicoolas"}
  description={description}
  image={ogImage}
  noindex={!movie}
>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}

  {error && <p class="text-destructive">{error}</p>}

  {
    movie && tmdbMovie && (
      <section class="relative mt-4 overflow-hidden rounded-2xl bg-neutral-900 text-white">
        {movie.backdropPath && (
          <img
            src={tmdbImageUrl(movie.backdropPath, 1280)}
            alt=""
            fetchpriority="high"
            class="absolute inset-0 size-full object-cover"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/65 to-black/40" />
        <div class="relative grid gap-6 p-4 sm:grid-cols-[200px_1fr] sm:p-8">
          <div>
            {movie.posterPath ? (
              <img
                src={tmdbImageUrl(movie.posterPath, 342)}
                srcset={tmdbWidthSrcSet(movie.posterPath, [185, 342, 500])}
                sizes="200px"
                alt=""
                class="w-full rounded-lg border object-cover"
              />
            ) : (
              <div class="flex aspect-[2/3] w-full items-center justify-center rounded-lg border bg-muted text-sm text-white/70">
                {movie.title}
              </div>
            )}
          </div>
          <div class="space-y-3">
            <div>
              <h1 class="text-2xl font-semibold">{movie.title}</h1>
              <p class="text-sm text-white/70">{subtitle}</p>
            </div>

            <MovieDetailActions movie={tmdbMovie} locale={locale} client:load />

            <p class="text-sm">{movie.overview || t.movie.noOverview}</p>

            {movie.externalRatings &&
              (movie.externalRatings.imdb ||
                movie.externalRatings.rottenTomatoes ||
                movie.externalRatings.metacritic) && (
                <div class="flex flex-wrap gap-3 text-sm">
                  {movie.externalRatings.imdb && (
                    <span>
                      <span class="font-medium">IMDb</span>{" "}
                      {movie.externalRatings.imdb}
                    </span>
                  )}
                  {movie.externalRatings.rottenTomatoes && (
                    <span>
                      <span class="font-medium">Rotten Tomatoes</span>{" "}
                      {movie.externalRatings.rottenTomatoes}
                    </span>
                  )}
                  {movie.externalRatings.metacritic && (
                    <span>
                      <span class="font-medium">Metacritic</span>{" "}
                      {movie.externalRatings.metacritic}
                    </span>
                  )}
                </div>
              )}

            {movie.cast.length > 0 && (
              <div class="space-y-2">
                <p class="text-sm font-medium">{t.movie.cast}</p>
                <div class="flex flex-wrap gap-3">
                  {movie.cast.map((member) => (
                    <a
                      href={`/person/${member.personId}`}
                      class="focus-ring flex w-20 flex-col items-center gap-1 text-center"
                    >
                      {member.profilePath ? (
                        <img
                          src={tmdbImageUrl(member.profilePath, 92)}
                          srcset={tmdbDensitySrcSet(member.profilePath, 45, 92)}
                          alt=""
                          class="size-12 rounded-full border object-cover"
                        />
                      ) : (
                        <div class="flex size-12 items-center justify-center rounded-full border bg-muted text-xs text-white/70">
                          {member.name.slice(0, 1)}
                        </div>
                      )}
                      <span class="w-full truncate text-xs">{member.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    movie && (
      <div class="mt-8">
        <h2 class="mb-4 text-xl font-semibold">{t.movie.similarMovies}</h2>
        <MovieMap locale={locale} seedMovieId={movie.id} client:load />
      </div>
    )
  }
</Layout>
