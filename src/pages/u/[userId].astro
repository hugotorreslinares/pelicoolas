---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import { UserProfile } from "@/components/social/UserProfile";

const { userId } = Astro.params;
if (!userId) return Astro.redirect("/");
const locale = Astro.locals.locale;
---

<Layout
  title="Profile — Pelicoolas"
  description="Follow a Pelicoolas user to see what they've watched, their watchlist, and their favorites."
  noindex
>
  <UserProfile locale={locale} userId={userId} client:load />
</Layout>
