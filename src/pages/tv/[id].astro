---
export const prerender = false;

import { setCdnCache } from "@/lib/cdnCache";
import Layout from "@/layouts/Layout.astro";
import { MovieDetailActions } from "@/components/movies/MovieDetailActions";
import { TrailerButton } from "@/components/movies/TrailerButton";
import CrewLine from "@/components/titles/CrewLine.astro";
import WatchProvidersSection from "@/components/titles/WatchProvidersSection.astro";
import RecommendedRow from "@/components/titles/RecommendedRow.astro";
import { getRecommendedTV, getTVDetails } from "@/lib/tmdb/tv";
import { resolveWatchRegion } from "@/lib/region";
import {
  tmdbImageUrl,
  tmdbWidthSrcSet,
  tmdbDensitySrcSet,
} from "@/lib/tmdb/image";
import { getDictionary } from "@/i18n";
import type { TVDetails } from "@/types/movie";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
const MAX_DESCRIPTION_LENGTH = 160;

function truncate(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  return `${text.slice(0, maxLength - 1).trimEnd()}…`;
}

const showId = Number(Astro.params.id);
let show: TVDetails | null = null;
let error: string | null = null;

if (!Number.isInteger(showId)) {
  error = t.movie.couldntLoadShow;
} else {
  try {
    const region = resolveWatchRegion(
      Astro.request.headers.get("accept-language"),
    );
    show = await getTVDetails(showId, region);
  } catch {
    error = t.movie.couldntLoadShow;
  }
}

// Public, anonymous-identical content: let Vercel's CDN serve it instead of
// running the function per visit. Vary keeps the per-locale/per-session-hint
// markup from leaking across visitors.
if (show) setCdnCache(Astro.response.headers, 86400);

const recommended = show ? await getRecommendedTV(show.id).catch(() => []) : [];

const description = show
  ? show.overview
    ? truncate(show.overview, MAX_DESCRIPTION_LENGTH)
    : t.movie.noOverview
  : undefined;
const ogImage = show?.posterPath
  ? tmdbImageUrl(show.posterPath, 500)
  : undefined;
const shareImage = show ? `/api/og/title/tv/${show.id}.png` : undefined;

const jsonLd = show
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TVSeries",
      name: show.title,
      ...(ogImage && { image: ogImage }),
      ...(show.overview && { description: show.overview }),
      ...(show.genres.length > 0 && { genre: show.genres }),
      ...(show.seasonCount && { numberOfSeasons: show.seasonCount }),
      ...(show.episodeCount && { numberOfEpisodes: show.episodeCount }),
      ...(show.voteAverage && {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: show.voteAverage,
          bestRating: 10,
          worstRating: 0,
        },
      }),
      ...(show.cast.length > 0 && {
        actor: show.cast.map((c) => ({ "@type": "Person", name: c.name })),
      }),
    }).replace(/</g, "\\u003c")
  : null;

const tmdbShow = show
  ? {
      tmdbMovieId: show.id,
      title: show.title,
      posterPath: show.posterPath,
      releaseYear: show.releaseYear,
      voteAverage: show.voteAverage,
      genreIds: show.genreIds,
      mediaType: "tv" as const,
    }
  : null;

const subtitle = show
  ? [
      show.releaseYear ?? t.movie.unknown,
      show.seasonCount ? t.movie.seasons(show.seasonCount) : null,
      show.genres.join(", ") || null,
    ]
      .filter(Boolean)
      .join(" · ")
  : "";
---

<Layout
  title={show ? `${show.title} — Pelicoolas` : "Pelicoolas"}
  description={description}
  image={shareImage ?? ogImage}
  imageAlt={show ? `${show.title} — Pelicoolas` : undefined}
  noindex={!show}
>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}

  {error && <p class="text-destructive">{error}</p>}

  {
    show && tmdbShow && (
      <div class="mt-4 grid gap-6 sm:grid-cols-[200px_1fr]">
        <div>
          {show.posterPath ? (
            <img
              src={tmdbImageUrl(show.posterPath, 342)}
              srcset={tmdbWidthSrcSet(show.posterPath, [185, 342, 500])}
              sizes="200px"
              alt=""
              class="w-full rounded-lg border object-cover"
            />
          ) : (
            <div class="flex aspect-[2/3] w-full items-center justify-center rounded-lg border bg-muted text-sm text-muted-foreground">
              {show.title}
            </div>
          )}
        </div>
        <div class="space-y-3">
          <div>
            <h1 class="font-display text-3xl font-bold tracking-tight">
              {show.title}
            </h1>
            <p class="text-sm text-muted-foreground">{subtitle}</p>
          </div>

          <MovieDetailActions movie={tmdbShow} locale={locale} client:load />
          {show.trailerKey && (
            <TrailerButton
              youtubeKey={show.trailerKey}
              title={show.title}
              locale={locale}
              client:load
            />
          )}

          <p class="text-sm">{show.overview || t.movie.noOverview}</p>

          <CrewLine crew={show.crew} locale={locale} />

          {show.externalRatings &&
            (show.externalRatings.imdb ||
              show.externalRatings.rottenTomatoes ||
              show.externalRatings.metacritic) && (
              <div class="flex flex-wrap gap-3 text-sm">
                {show.externalRatings.imdb && (
                  <span>
                    <span class="font-medium">IMDb</span>{" "}
                    {show.externalRatings.imdb}
                  </span>
                )}
                {show.externalRatings.rottenTomatoes && (
                  <span>
                    <span class="font-medium">Rotten Tomatoes</span>{" "}
                    {show.externalRatings.rottenTomatoes}
                  </span>
                )}
                {show.externalRatings.metacritic && (
                  <span>
                    <span class="font-medium">Metacritic</span>{" "}
                    {show.externalRatings.metacritic}
                  </span>
                )}
              </div>
            )}

          {show.cast.length > 0 && (
            <div class="space-y-2 pt-2">
              <h2 class="font-display text-lg font-bold">{t.movie.cast}</h2>
              <div class="flex gap-3 overflow-x-auto pb-2">
                {show.cast.map((member) => (
                  <a
                    href={`/person/${member.personId}`}
                    class="focus-ring group w-24 shrink-0 space-y-1.5"
                  >
                    {member.profilePath ? (
                      <img
                        src={tmdbImageUrl(member.profilePath, 185)}
                        srcset={tmdbDensitySrcSet(member.profilePath, 92, 185)}
                        alt=""
                        loading="lazy"
                        class="aspect-[2/3] w-full rounded-lg border object-cover transition-transform group-hover:scale-[1.03]"
                      />
                    ) : (
                      <div class="flex aspect-[2/3] w-full items-center justify-center rounded-lg border bg-muted text-xl text-muted-foreground">
                        {member.name.slice(0, 1)}
                      </div>
                    )}
                    <p class="line-clamp-2 text-xs leading-tight font-medium">
                      {member.name}
                    </p>
                    {member.character && (
                      <p class="line-clamp-2 text-[11px] leading-tight text-muted-foreground">
                        {member.character}
                      </p>
                    )}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    )
  }
  {
    show && (
      <div class="mt-8 space-y-8">
        <WatchProvidersSection
          providers={show.watchProviders}
          locale={locale}
        />
        <RecommendedRow items={recommended} locale={locale} mediaType="tv" />
      </div>
    )
  }
</Layout>
