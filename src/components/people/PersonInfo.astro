---
import type { PersonProfile } from "@/types/person";
import { calculateAge } from "@/lib/age";

interface Props {
  profile: PersonProfile;
  movieCount: number;
}

const { profile, movieCount } = Astro.props;

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const genderLabel =
  profile.gender === "female"
    ? "Female"
    : profile.gender === "male"
      ? "Male"
      : profile.gender === "non-binary"
        ? "Non-binary"
        : null;

const birthdayLine = profile.birthday
  ? profile.deathday
    ? `${formatDate(profile.birthday)} — ${formatDate(profile.deathday)} (${calculateAge(profile.birthday, profile.deathday)} years old)`
    : `${formatDate(profile.birthday)} (${calculateAge(profile.birthday)} years old)`
  : null;
---

<aside class="w-full sm:w-64">
  <details class="group sm:hidden">
    <summary class="cursor-pointer list-none font-semibold">
      <span class="inline-flex items-center gap-1">
        Personal Info
        <span class="transition-transform group-open:rotate-180">▾</span>
      </span>
    </summary>
    <div class="mt-4">
      {
        profile.knownForDepartment && (
          <div class="mb-4">
            <p class="text-sm font-medium">Known For</p>
            <p class="text-sm text-muted-foreground">
              {profile.knownForDepartment}
            </p>
          </div>
        )
      }
      <div class="mb-4">
        <p class="text-sm font-medium">Known Credits</p>
        <p class="text-sm text-muted-foreground">{movieCount}</p>
      </div>
      {
        genderLabel && (
          <div class="mb-4">
            <p class="text-sm font-medium">Gender</p>
            <p class="text-sm text-muted-foreground">{genderLabel}</p>
          </div>
        )
      }
      {
        birthdayLine && (
          <div class="mb-4">
            <p class="text-sm font-medium">
              {profile.deathday ? "Birthday — Deathday" : "Birthday"}
            </p>
            <p class="text-sm text-muted-foreground">{birthdayLine}</p>
          </div>
        )
      }
      {
        profile.placeOfBirth && (
          <div class="mb-4">
            <p class="text-sm font-medium">Place of Birth</p>
            <p class="text-sm text-muted-foreground">{profile.placeOfBirth}</p>
          </div>
        )
      }
      {
        profile.alsoKnownAs.length > 0 && (
          <div>
            <p class="text-sm font-medium">Also Known As</p>
            <ul class="text-sm text-muted-foreground">
              {profile.alsoKnownAs.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </details>

  <div class="hidden space-y-4 sm:block">
    <h2 class="font-semibold">Personal Info</h2>
    {
      profile.knownForDepartment && (
        <div>
          <p class="text-sm font-medium">Known For</p>
          <p class="text-sm text-muted-foreground">
            {profile.knownForDepartment}
          </p>
        </div>
      )
    }
    <div>
      <p class="text-sm font-medium">Known Credits</p>
      <p class="text-sm text-muted-foreground">{movieCount}</p>
    </div>
    {
      genderLabel && (
        <div>
          <p class="text-sm font-medium">Gender</p>
          <p class="text-sm text-muted-foreground">{genderLabel}</p>
        </div>
      )
    }
    {
      birthdayLine && (
        <div>
          <p class="text-sm font-medium">
            {profile.deathday ? "Birthday — Deathday" : "Birthday"}
          </p>
          <p class="text-sm text-muted-foreground">{birthdayLine}</p>
        </div>
      )
    }
    {
      profile.placeOfBirth && (
        <div>
          <p class="text-sm font-medium">Place of Birth</p>
          <p class="text-sm text-muted-foreground">{profile.placeOfBirth}</p>
        </div>
      )
    }
    {
      profile.alsoKnownAs.length > 0 && (
        <div>
          <p class="text-sm font-medium">Also Known As</p>
          <ul class="text-sm text-muted-foreground">
            {profile.alsoKnownAs.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</aside>
