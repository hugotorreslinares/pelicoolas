---
import "../styles/global.css";
import { UserMenu } from "@/components/auth/UserMenu";
import { ThemeToggle } from "@/components/theme/ThemeToggle";
import { FollowedDock } from "@/components/filmography/FollowedDock";
import { SearchIcon, FilmIcon, BookmarkIcon } from "lucide-react";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  showDeployInfo?: boolean;
  /** Pages with no real content for a signed-out crawler (personal dashboards) opt out of indexing. */
  noindex?: boolean;
  /** Overrides the canonical path when a page duplicates another URL's content (e.g. /filmographies mirrors /). */
  canonicalPath?: string;
  /** Absolute or root-relative image URL for Open Graph/Twitter previews. */
  image?: string;
}

const {
  title = "Filmo",
  description = "Track which movies from your favorite actors' and directors' filmographies you've already watched.",
  showDeployInfo = false,
  noindex = false,
  canonicalPath = Astro.url.pathname,
  image = "/pwa-512x512.png",
} = Astro.props;

const canonicalURL = new URL(canonicalPath, Astro.site);
const ogImageURL = new URL(image, Astro.site);

// /filmographies mirrors / (same <Dashboard>), so both should read as "on
// the My Filmographies tab" — otherwise landing on / shows no active state
// at all.
const pathname = Astro.url.pathname;
const isSearchActive = pathname === "/search";
const isFilmographiesActive = pathname === "/" || pathname === "/filmographies";
const isWatchlistActive = pathname === "/watchlist";

const navLinkClass = (active: boolean) =>
  `focus-ring flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm transition-colors ${
    active
      ? "bg-foreground text-background"
      : "text-muted-foreground hover:bg-muted hover:text-foreground"
  }`;

const deployedAt = new Date(__BUILD_TIME__).toLocaleString("en-US", {
  dateStyle: "medium",
  timeStyle: "short",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script is:inline>
      // Blocking, runs before first paint — avoids a flash of the wrong theme.
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const dark = stored
            ? stored === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          // localStorage/matchMedia unavailable (privacy mode, old browser) — default light theme stands.
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Filmo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link
      rel="icon"
      href="/pwa-source-icon.svg"
      sizes="any"
      type="image/svg+xml"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />

    <Analytics />
    <SpeedInsights />
    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js");
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <div id="a11y-announcer" role="status" aria-live="polite" class="sr-only">
    </div>
    <div class="film-perforations film-perforations-left" aria-hidden="true">
    </div>
    <div class="film-perforations film-perforations-right" aria-hidden="true">
    </div>
    <header class="border-b">
      <div
        class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-y-2 p-4"
      >
        <a href="/" class="focus-ring text-lg font-bold tracking-tight">FILMO</a
        >
        <div class="flex flex-wrap items-center gap-3 sm:gap-4">
          <nav
            aria-label="Main"
            class="flex items-center gap-1 rounded-full border p-1"
          >
            <a
              href="/search"
              class={navLinkClass(isSearchActive)}
              aria-current={isSearchActive ? "page" : undefined}
              title="Search"
            >
              <SearchIcon className="size-4" />
              <span class="sr-only">Search</span>
            </a>
            <a
              href="/filmographies"
              class={navLinkClass(isFilmographiesActive)}
              aria-current={isFilmographiesActive ? "page" : undefined}
              title="My Filmographies"
            >
              <FilmIcon className="size-4" />
              <span class="sr-only">My Filmographies</span>
            </a>
            <a
              href="/watchlist"
              class={navLinkClass(isWatchlistActive)}
              aria-current={isWatchlistActive ? "page" : undefined}
              title="Watchlist"
            >
              <BookmarkIcon className="size-4" />
              <span class="sr-only">Watchlist</span>
            </a>
          </nav>
          <FollowedDock client:idle />
          <ThemeToggle client:idle />
          <UserMenu client:idle />
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-5xl p-4">
      <slot />
    </main>
    <footer
      class="mx-auto max-w-5xl space-y-1 p-4 text-xs text-muted-foreground"
    >
      <p>
        This product uses the TMDB API but is not endorsed or certified by TMDB.
      </p>
      {showDeployInfo && <p class="opacity-70">Deployed {deployedAt}</p>}
    </footer>
  </body>
</html>
