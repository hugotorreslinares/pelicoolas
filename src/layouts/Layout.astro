---
import "../styles/global.css";
import { UserMenu } from "@/components/auth/UserMenu";
import { ThemeToggle } from "@/components/theme/ThemeToggle";
import { NotificationBell } from "@/components/notifications/NotificationBell";
import { MobileNav } from "@/components/nav/MobileNav";
import { OnboardingCarousel } from "@/components/onboarding/OnboardingCarousel";
import { UsernamePrompt } from "@/components/onboarding/UsernamePrompt";
import { Toaster } from "@/components/ui/sonner";
import { HeaderSearch } from "@/components/search/HeaderSearch";
import { SidebarSearch } from "@/components/search/SidebarSearch";
import { LocaleToggle } from "@/components/locale/LocaleToggle";
import {
  FilmIcon,
  BookmarkIcon,
  NetworkIcon,
  EyeIcon,
  UsersIcon,
  WaypointsIcon,
  GhostIcon,
} from "lucide-react";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { getDictionary } from "@/i18n";

interface Props {
  title?: string;
  description?: string;
  showDeployInfo?: boolean;
  /** Pages with no real content for a signed-out crawler (personal dashboards) opt out of indexing. */
  noindex?: boolean;
  /** Overrides the canonical path when a page duplicates another URL's content (e.g. /filmographies mirrors /). */
  canonicalPath?: string;
  /** Absolute or root-relative image URL for Open Graph/Twitter previews. */
  image?: string;
  /** Alt text for the preview image; setting it also marks the image as a 1200×630 card. */
  imageAlt?: string;
}

const {
  title = "Pelicoolas",
  description = "Track which movies from your favorite actors' and directors' filmographies you've already watched.",
  showDeployInfo = false,
  noindex = false,
  canonicalPath = Astro.url.pathname,
  image = "/pwa-512x512.png",
  imageAlt,
} = Astro.props;

const canonicalURL = new URL(canonicalPath, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const locale = Astro.locals.locale;
const t = getDictionary(locale);

// /filmographies mirrors / (same <Dashboard>), so both should read as "on
// the My Filmographies tab" — otherwise landing on / shows no active state
// at all.
const pathname = Astro.url.pathname;
const isSearchActive = pathname === "/search";
const isFilmographiesActive = pathname === "/" || pathname === "/filmographies";
const isWatchedActive = pathname === "/watched";
const isWatchlistActive = pathname === "/watchlist";
const isConnectionsActive = pathname === "/connections";
const isMapActive = pathname === "/map";
const isFriendsActive = pathname === "/friends";
const isHalloweenActive = pathname === "/halloween";

// size-11 (44px): minimum comfortable touch target on mobile — these are
// icon-only links (visible label is sr-only), so padding alone previously
// left them at ~28-32px, smaller than a thumb tap.
const navLinkClass = (active: boolean) =>
  `focus-ring flex size-11 items-center justify-center rounded-full text-sm transition-colors ${
    active
      ? "bg-foreground text-background"
      : "text-muted-foreground hover:bg-muted hover:text-foreground"
  }`;

// Desktop sidebar: icon+text row instead of the header's icon-only pill.
const sidebarLinkClass = (active: boolean) =>
  `focus-ring flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
    active
      ? "bg-foreground text-background"
      : "text-muted-foreground hover:bg-muted hover:text-foreground"
  }`;

const deployedAt = new Date(__BUILD_TIME__).toLocaleString(
  locale === "es" ? "es-ES" : "en-US",
  { dateStyle: "medium", timeStyle: "short" },
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script is:inline>
      // Blocking, runs before first paint — avoids a flash of the wrong theme.
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const dark = stored
            ? stored === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          // localStorage/matchMedia unavailable (privacy mode, old browser) — default light theme stands.
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pelicoolas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {
      imageAlt && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={imageAlt} />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={imageAlt ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link
      rel="icon"
      href="/pwa-source-icon.svg"
      sizes="any"
      type="image/svg+xml"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />

    <Analytics />
    <SpeedInsights />
    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js");
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a
      href="#main-content"
      class="focus-ring sr-only rounded-full bg-foreground px-4 py-2 text-background focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      Skip to content
    </a>
    <div id="a11y-announcer" role="status" aria-live="polite" class="sr-only">
    </div>
    <div class="film-perforations film-perforations-left" aria-hidden="true">
    </div>
    <div class="film-perforations film-perforations-right" aria-hidden="true">
    </div>
    <div class="md:flex">
      <aside
        class="sticky top-0 hidden h-screen w-64 shrink-0 flex-col justify-between overflow-x-hidden overflow-y-auto border-r p-4 md:flex"
      >
        <div class="space-y-6">
          <a
            href="/"
            class="focus-ring flex items-center gap-2 text-lg font-bold tracking-tight"
          >
            <img src="/logo.png" alt="" width="32" height="32" class="size-8" />
            PELICOOLAS
          </a>
          <SidebarSearch locale={locale} client:idle />
          <nav aria-label="Main" class="flex flex-col gap-1">
            <a
              href="/filmographies"
              class={sidebarLinkClass(isFilmographiesActive)}
              aria-current={isFilmographiesActive ? "page" : undefined}
            >
              <FilmIcon className="size-4" />
              {t.nav.myFilmographies}
            </a>
            <a
              href="/watched"
              class={sidebarLinkClass(isWatchedActive)}
              aria-current={isWatchedActive ? "page" : undefined}
            >
              <EyeIcon className="size-4" />
              {t.nav.watched}
            </a>
            <a
              href="/watchlist"
              class={sidebarLinkClass(isWatchlistActive)}
              aria-current={isWatchlistActive ? "page" : undefined}
            >
              <BookmarkIcon className="size-4" />
              {t.nav.watchlist}
            </a>
            <a
              href="/connections"
              class={sidebarLinkClass(isConnectionsActive)}
              aria-current={isConnectionsActive ? "page" : undefined}
            >
              <NetworkIcon className="size-4" />
              {t.nav.connections}
            </a>
            <a
              href="/map"
              class={sidebarLinkClass(isMapActive)}
              aria-current={isMapActive ? "page" : undefined}
            >
              <WaypointsIcon className="size-4" />
              {t.nav.movieMap}
            </a>
            <a
              href="/friends"
              class={sidebarLinkClass(isFriendsActive)}
              aria-current={isFriendsActive ? "page" : undefined}
            >
              <UsersIcon className="size-4" />
              {t.nav.friends}
            </a>
            <p
              class="px-3 pt-4 pb-1 text-xs font-semibold tracking-wide text-muted-foreground uppercase"
            >
              {t.nav.lists}
            </p>
            <a
              href="/halloween"
              class={sidebarLinkClass(isHalloweenActive)}
              aria-current={isHalloweenActive ? "page" : undefined}
            >
              <GhostIcon className="size-4" />
              {t.nav.halloween}
            </a>
          </nav>
        </div>
        <div class="flex flex-wrap items-center gap-1 border-t pt-4">
          <NotificationBell client:idle />
          <LocaleToggle
            locale={locale}
            label={t.locale.switchLanguage}
            client:idle
          />
          <ThemeToggle label={t.account.toggleTheme} client:idle />
          <UserMenu
            locale={locale}
            loginClassName="order-first mb-2 w-full"
            client:idle
          />
        </div>
      </aside>
      <div class="flex min-h-screen flex-1 flex-col">
        <header class="border-b md:hidden">
          <div
            class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-y-2 p-4 sm:px-6 lg:px-8"
          >
            <a
              href="/"
              class="focus-ring flex items-center gap-2 text-lg font-bold tracking-tight"
            >
              <img
                src="/logo.png"
                alt=""
                width="32"
                height="32"
                class="size-8"
              />
              PELICOOLAS
            </a>
            <div class="ml-auto flex items-center gap-2 sm:gap-4">
              <nav
                aria-label="Main"
                class="hidden items-center gap-1 rounded-full border p-1 sm:flex"
              >
                <HeaderSearch
                  locale={locale}
                  className={navLinkClass(isSearchActive)}
                  client:idle
                />
                <a
                  href="/filmographies"
                  class={navLinkClass(isFilmographiesActive)}
                  aria-current={isFilmographiesActive ? "page" : undefined}
                  title={t.nav.myFilmographies}
                >
                  <FilmIcon className="size-4" />
                  <span class="sr-only">{t.nav.myFilmographies}</span>
                </a>
                <a
                  href="/watched"
                  class={navLinkClass(isWatchedActive)}
                  aria-current={isWatchedActive ? "page" : undefined}
                  title={t.nav.watched}
                >
                  <EyeIcon className="size-4" />
                  <span class="sr-only">{t.nav.watched}</span>
                </a>
                <a
                  href="/watchlist"
                  class={navLinkClass(isWatchlistActive)}
                  aria-current={isWatchlistActive ? "page" : undefined}
                  title={t.nav.watchlist}
                >
                  <BookmarkIcon className="size-4" />
                  <span class="sr-only">{t.nav.watchlist}</span>
                </a>
                <a
                  href="/connections"
                  class={navLinkClass(isConnectionsActive)}
                  aria-current={isConnectionsActive ? "page" : undefined}
                  title={t.nav.connections}
                >
                  <NetworkIcon className="size-4" />
                  <span class="sr-only">{t.nav.connections}</span>
                </a>
                <a
                  href="/map"
                  class={navLinkClass(isMapActive)}
                  aria-current={isMapActive ? "page" : undefined}
                  title={t.nav.movieMap}
                >
                  <WaypointsIcon className="size-4" />
                  <span class="sr-only">{t.nav.movieMap}</span>
                </a>
                <a
                  href="/friends"
                  class={navLinkClass(isFriendsActive)}
                  aria-current={isFriendsActive ? "page" : undefined}
                  title={t.nav.friends}
                >
                  <UsersIcon className="size-4" />
                  <span class="sr-only">{t.nav.friends}</span>
                </a>
                <a
                  href="/halloween"
                  class={navLinkClass(isHalloweenActive)}
                  aria-current={isHalloweenActive ? "page" : undefined}
                  title={`${t.nav.lists}: ${t.nav.halloween}`}
                >
                  <GhostIcon className="size-4" />
                  <span class="sr-only">{t.nav.halloween}</span>
                </a>
              </nav>
              <NotificationBell client:idle />
              <LocaleToggle
                locale={locale}
                label={t.locale.switchLanguage}
                client:idle
              />
              <ThemeToggle label={t.account.toggleTheme} client:idle />
              <UserMenu locale={locale} client:idle />
              <MobileNav locale={locale} client:idle />
            </div>
          </div>
        </header>
        <main
          id="main-content"
          class="mx-auto w-full max-w-6xl flex-1 p-4 sm:px-6 lg:px-8"
        >
          <slot />
        </main>
        <OnboardingCarousel locale={locale} client:idle />
        <UsernamePrompt locale={locale} client:idle />
        <Toaster client:idle />
        <footer class="mt-8 w-full border-t">
          <div
            class="mx-auto grid w-full max-w-6xl gap-8 p-4 text-sm sm:px-6 md:grid-cols-[1.5fr_repeat(3,1fr)] lg:px-8"
          >
            <div class="space-y-2">
              <a
                href="/"
                class="focus-ring flex items-center gap-2 font-bold tracking-tight"
              >
                <img
                  src="/logo.png"
                  alt=""
                  width="28"
                  height="28"
                  class="size-7"
                />
                PELICOOLAS
              </a>
              <p class="max-w-xs text-xs text-muted-foreground">
                {t.footer.tagline}
              </p>
            </div>
            <nav aria-label={t.footer.exploreHeading} class="space-y-2">
              <p class="font-medium">{t.footer.exploreHeading}</p>
              <ul class="space-y-1 text-muted-foreground">
                <li>
                  <a
                    href="/search"
                    class="focus-ring hover:text-foreground hover:underline"
                    >{t.nav.search}</a
                  >
                </li>
                <li>
                  <a
                    href="/filmographies"
                    class="focus-ring hover:text-foreground hover:underline"
                    >{t.nav.myFilmographies}</a
                  >
                </li>
                <li>
                  <a
                    href="/watchlist"
                    class="focus-ring hover:text-foreground hover:underline"
                    >{t.nav.watchlist}</a
                  >
                </li>
                <li>
                  <a
                    href="/map"
                    class="focus-ring hover:text-foreground hover:underline"
                    >{t.nav.movieMap}</a
                  >
                </li>
              </ul>
            </nav>
            <nav aria-label={t.footer.communityHeading} class="space-y-2">
              <p class="font-medium">{t.footer.communityHeading}</p>
              <ul class="space-y-1 text-muted-foreground">
                <li>
                  <a
                    href="/friends"
                    class="focus-ring hover:text-foreground hover:underline"
                    >{t.nav.friends}</a
                  >
                </li>
                <li>
                  <a
                    href="/halloween"
                    class="focus-ring hover:text-foreground hover:underline"
                    >{t.footer.halloweenLink}</a
                  >
                </li>
                <li>
                  <a
                    href="https://www.instagram.com/pelicool.as/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="focus-ring hover:text-foreground hover:underline"
                    >Instagram</a
                  >
                </li>
              </ul>
            </nav>
            <nav aria-label={t.footer.legalHeading} class="space-y-2">
              <p class="font-medium">{t.footer.legalHeading}</p>
              <ul class="space-y-1 text-muted-foreground">
                <li>
                  <a
                    href="/privacy"
                    class="focus-ring hover:text-foreground hover:underline"
                    >{t.footer.privacyLink}</a
                  >
                </li>
              </ul>
            </nav>
          </div>
          <div
            class="mx-auto w-full max-w-6xl space-y-1 px-4 pb-6 text-xs text-muted-foreground sm:px-6 lg:px-8"
          >
            <p>{t.footer.copyright(new Date().getFullYear())}</p>
            <p>{t.footer.tmdbAttribution}</p>
            {showDeployInfo && <p>{t.footer.deployed(deployedAt)}</p>}
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
